#!/usr/bin/env python3
"""Independent semantic review of one generated PAF bootstrap task contract."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import selectors
import signal
import subprocess
import time
from pathlib import Path
from typing import Any

JSON_BEGIN = "<PAF_TASK_REVIEW_JSON>"
JSON_END = "</PAF_TASK_REVIEW_JSON>"
VERDICT_TAG = "TASK_REVIEW_VERDICT"


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def load_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise SystemExit(f"Expected JSON object in {path}")
    return value


def save_json_atomic(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def typed_digest(label: str, value: Any) -> str:
    h = hashlib.sha256()
    h.update(label.encode("utf-8"))
    h.update(b"\x00")
    h.update(canonical_bytes(value))
    return "sha256:" + h.hexdigest()


def sanitize_json_line(raw: bytes) -> bytes:
    stripped = raw.rstrip(b"\r\n")
    if not stripped:
        return b"\n"
    try:
        obj = json.loads(stripped.decode("utf-8", errors="replace"))
    except json.JSONDecodeError:
        return stripped + b"\n"
    if isinstance(obj, dict):
        obj.pop("accumulated", None)
        event = obj.get("event")
        if isinstance(event, dict):
            event.pop("accumulated", None)
    return json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"


def run_cline(command: list[str], env: dict[str, str], jsonl_path: Path, stderr_path: Path,
              total_timeout: int, inactivity_timeout: int) -> int:
    started = last_activity = time.monotonic()
    buffer = bytearray()
    with stderr_path.open("ab", buffering=0) as err, jsonl_path.open("wb") as out:
        proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=err, env=env,
                                start_new_session=True, bufsize=0)
        assert proc.stdout is not None
        fd = proc.stdout.fileno()
        os.set_blocking(fd, False)
        selector = selectors.DefaultSelector()
        selector.register(fd, selectors.EVENT_READ)
        forced_rc: int | None = None
        eof = False
        while True:
            now = time.monotonic()
            if forced_rc is None and total_timeout > 0 and now - started > total_timeout:
                forced_rc = 124
                os.killpg(proc.pid, signal.SIGTERM)
            if forced_rc is None and inactivity_timeout > 0 and now - last_activity > inactivity_timeout:
                forced_rc = 125
                os.killpg(proc.pid, signal.SIGTERM)
            for _key, _mask in selector.select(timeout=1.0):
                try:
                    chunk = os.read(fd, 65536)
                except BlockingIOError:
                    chunk = b""
                if chunk:
                    last_activity = time.monotonic()
                    buffer.extend(chunk)
                    while b"\n" in buffer:
                        line, _, rest = buffer.partition(b"\n")
                        buffer = bytearray(rest)
                        out.write(sanitize_json_line(line))
                        out.flush()
                else:
                    eof = True
                    try:
                        selector.unregister(fd)
                    except Exception:
                        pass
            rc = proc.poll()
            if rc is not None:
                if not eof:
                    while True:
                        try:
                            chunk = os.read(fd, 65536)
                        except BlockingIOError:
                            time.sleep(0.05)
                            continue
                        if not chunk:
                            break
                        buffer.extend(chunk)
                if buffer:
                    out.write(sanitize_json_line(bytes(buffer)))
                return forced_rc if forced_rc is not None else rc
            if forced_rc is not None:
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(proc.pid, signal.SIGKILL)


def extract_final_text(path: Path) -> str:
    final = ""
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if obj.get("type") == "run_result" and isinstance(obj.get("text"), str):
            final = obj["text"].strip()
    return final


def parse_review(text: str) -> dict[str, Any]:
    verdicts = re.findall(rf"(?m)^{VERDICT_TAG}=(APPROVED|BLOCKED)$", text)
    if len(verdicts) != 1:
        raise SystemExit(f"Expected exactly one {VERDICT_TAG} marker")
    start, end = text.find(JSON_BEGIN), text.find(JSON_END)
    if start < 0 or end < 0 or end <= start:
        raise SystemExit("Task review output is missing the structured JSON envelope")
    value = json.loads(text[start + len(JSON_BEGIN):end].strip())
    if not isinstance(value, dict):
        raise SystemExit("Task review JSON must be an object")
    if value.get("verdict") != verdicts[0]:
        raise SystemExit("Task review JSON verdict does not match terminal marker")
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", required=True)
    parser.add_argument("--campaign-config", required=True)
    parser.add_argument("--task", required=True)
    parser.add_argument("--metadata", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--review-config", default=os.environ.get("PAF_TASK_REVIEW_CONFIG", "~/.cline-opus"))
    parser.add_argument("--template")
    parser.add_argument("--phase-timeout", type=int, default=int(os.environ.get("PAF_TASK_REVIEW_TIMEOUT", "1800")))
    parser.add_argument("--inactivity-timeout", type=int, default=int(os.environ.get("PAF_INACTIVITY_TIMEOUT", "900")))
    parser.add_argument("--thinking", default="high")
    args = parser.parse_args()

    repo = Path(args.repo).expanduser().resolve()
    config_path = Path(args.campaign_config).expanduser().resolve()
    task_path = Path(args.task).expanduser().resolve()
    metadata_path = Path(args.metadata).expanduser().resolve()
    output_dir = Path(args.output_dir).expanduser().resolve()
    config = load_json(config_path)
    metadata = load_json(metadata_path)

    task_markdown = task_path.read_text(encoding="utf-8")
    if task_markdown.rstrip() != str(metadata.get("task_markdown", "")).rstrip():
        raise SystemExit("Task Markdown does not match task metadata")

    digest_input = dict(metadata)
    supplied_digest = digest_input.pop("task_contract_digest", None)
    computed_digest = typed_digest("paf-bootstrap-task-contract-v2", digest_input)
    if supplied_digest != computed_digest:
        raise SystemExit("Task contract digest verification failed")

    backlog = {item["id"]: item for item in config.get("backlog", []) if isinstance(item, dict) and "id" in item}
    item = backlog.get(metadata.get("backlog_item_id"))
    if not isinstance(item, dict):
        raise SystemExit("Task backlog item is missing from campaign configuration")

    template_path = (Path(args.template).expanduser().resolve() if args.template
                     else Path(__file__).resolve().parent / "templates" / "task-review-prompt.md")
    if not template_path.is_file():
        raise SystemExit(f"Missing task-review prompt template: {template_path}")
    review_config = Path(args.review_config).expanduser().resolve()
    if not review_config.is_dir():
        raise SystemExit(f"Missing task-review Cline configuration: {review_config}")
    if not os.environ.get("LITELLM_API_KEY") or not os.environ.get("OPENAI_API_KEY"):
        raise SystemExit("LITELLM_API_KEY and OPENAI_API_KEY must both be set")

    documents: dict[str, str] = {}
    for name, relative in config.get("documents", {}).items():
        path = (repo / relative).resolve()
        if path.is_file():
            documents[name] = path.read_text(encoding="utf-8", errors="replace")

    subject = {
        "task_contract_digest": supplied_digest,
        "generated_base_sha": metadata.get("generated_base_sha"),
        "backlog_item": item,
        "task_metadata": metadata,
        "task_markdown": task_markdown,
        "authoritative_documents": documents,
    }
    prompt = template_path.read_text(encoding="utf-8") + "\n\n# Immutable review subject\n\n```json\n" + json.dumps(subject, indent=2, sort_keys=True) + "\n```\n"

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_dir = output_dir / f"{metadata['task_id']}-{stamp}"
    run_dir.mkdir(parents=True, exist_ok=False)
    (run_dir / "prompt.md").write_text(prompt, encoding="utf-8")
    jsonl_path = run_dir / "review.jsonl"
    stderr_path = run_dir / "review.stderr.log"

    permissions = json.dumps({"deny": [
        "sudo *", "rm -rf *", "docker *", "podman *", "ssh *", "scp *", "curl *", "wget *",
        "git add *", "git commit *", "git push *", "git checkout *", "git switch *", "git worktree *",
        "git reset *", "git clean *", "gh *"
    ], "allowRedirects": False}, separators=(",", ":"))
    env = os.environ.copy()
    env["CLINE_COMMAND_PERMISSIONS"] = permissions
    command = [
        "cline", "--json", "--auto-approve", "true", "--plan",
        "--timeout", str(args.phase_timeout), "--thinking", args.thinking,
        "--config", str(review_config), "--cwd", str(repo), prompt,
    ]
    rc = run_cline(command, env, jsonl_path, stderr_path, args.phase_timeout, args.inactivity_timeout)
    if rc != 0:
        raise SystemExit(f"Independent task review failed with exit code {rc}; see {run_dir}")

    text = extract_final_text(jsonl_path)
    (run_dir / "review.txt").write_text(text + ("\n" if text and not text.endswith("\n") else ""), encoding="utf-8")
    review = parse_review(text)

    required = {"schema_version", "task_id", "task_contract_digest", "generated_base_sha",
                "criteria", "findings", "verdict", "summary"}
    missing = sorted(required - set(review))
    if missing:
        raise SystemExit(f"Task review is missing required fields: {missing}")
    if review["task_id"] != metadata["task_id"]:
        raise SystemExit("Task review is bound to the wrong task")
    if review["task_contract_digest"] != supplied_digest:
        raise SystemExit("Task review is bound to the wrong task digest")
    if review["generated_base_sha"] != metadata["generated_base_sha"]:
        raise SystemExit("Task review is bound to the wrong base SHA")
    if review["verdict"] not in {"APPROVED", "BLOCKED"}:
        raise SystemExit("Invalid task review verdict")
    if not isinstance(review["criteria"], list) or not isinstance(review["findings"], list):
        raise SystemExit("Task review criteria/findings must be arrays")

    review["reviewed_at"] = utc_now()
    review["review_attempt_dir"] = str(run_dir)
    review["review_profile"] = str(review_config)
    review["review_record_digest"] = typed_digest("paf-bootstrap-task-review-v1", review)

    review_json = task_path.with_suffix(".review.json")
    review_md = task_path.with_suffix(".review.md")
    save_json_atomic(review_json, review)
    review_md.write_text(text + ("\n" if not text.endswith("\n") else ""), encoding="utf-8")
    save_json_atomic(run_dir / "result.json", review)

    print(json.dumps({
        "status": "approved" if review["verdict"] == "APPROVED" else "blocked",
        "task_id": metadata["task_id"],
        "task_contract_digest": supplied_digest,
        "review_json": str(review_json),
        "review_markdown": str(review_md),
        "review_attempt_dir": str(run_dir),
        "summary": review["summary"],
    }, indent=2, sort_keys=True))
    return 0 if review["verdict"] == "APPROVED" else 2


if __name__ == "__main__":
    raise SystemExit(main())
